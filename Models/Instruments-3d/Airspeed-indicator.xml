<?xml version="1.0"?>

<PropertyList>
   <path>Airspeed-indicator.ac</path>
   <animation>
    <type>material</type>
       <object-name>Cube.001</object-name>
       <object-name>10thsAS</object-name>
       <object-name>10sAS</object-name>
       <object-name>100sAS</object-name>
       <object-name>1000sAS</object-name>
       <object-name>needle</object-name>
       <object-name>OFF</object-name>
	   <emission>
		 <red>0.9</red>
		 <green>0.5</green>
		 <blue>0.9</blue>
		 <factor-prop>controls/lighting/AFCS_indexers_pilot</factor-prop>
	  </emission>
    </animation> 

  <animation>
   <type>textranslate</type>
   <object-name>1000sAS</object-name> 
   <property>instrumentation/airspeed-indicator/displayed-speed</property>
   <factor>0.0001</factor> 
   <step>1000</step> 
   <axis> 
    <x>0</x> 
    <y>-1</y> 
    <z>0</z> 
   </axis> 
  </animation>  

  <animation>
   <type>textranslate</type>
   <object-name>100sAS</object-name>
   <property>instrumentation/airspeed-indicator/displayed-speed</property>
   <factor>0.001</factor> 
   <step>100</step> 
   <axis> 
    <x>0</x> 
    <y>-1</y> 
    <z>0</z> 
   </axis> 
  </animation>  

  <animation>
   <type>textranslate</type>
   <object-name>10sAS</object-name>
   <property>instrumentation/airspeed-indicator/displayed-speed</property>
   <factor>0.01</factor> 
   <step>10</step>   
   <axis> 
    <x>0</x> 
    <y>-1</y> 
    <z>0</z> 
   </axis> 
  </animation> 


  <animation>
   <type>textranslate</type>
   <object-name>10thsAS</object-name>
   <property>instrumentation/airspeed-indicator/displayed-speed</property>
   <factor>0.1</factor> 
   <step>1</step> 
   <axis> 
    <x>0</x> 
    <y>-1</y> 
    <z>0</z> 
   </axis>
  </animation> 

    <animation>
        <type>select</type>
        <object-name>OFF</object-name>
        <condition>
           <or>
            <less-than>
                <property>instrumentation/airspeed-indicator/needle-value</property>
                <value>0.5</value>
            </less-than>
            <less-than>
                <property>systems/electrical/bus/ac-2/voltage</property>
                <value>220</value>
            </less-than>
           </or>
        </condition> 
     </animation>

<animation>
	<type>rotate</type>
	<object-name>needle</object-name>
	<property>instrumentation/airspeed-indicator/needle-value</property>
	<interpolation>
		<entry>
			<ind>0.0</ind>
			<dep>0.0</dep>
		</entry>
		<entry>
			<ind>0.5</ind>
			<dep>45</dep>
		</entry>
		<entry>
			<ind>1.00</ind>
			<dep>90</dep>
		</entry>
	</interpolation>
	<axis>
		<x>-1.0</x>
		<y>0.0</y>
		<z>0.0</z>
	</axis>
	<center>
            <x-m>0.0055</x-m>
            <y-m>0.0082</y-m>
            <z-m>-0.0122</z-m>
	</center>
</animation> 

<animation>
	<type>pick</type>
	<object-name>needle</object-name>
	<action>
		<button>0</button>
		<repeatable>true</repeatable>
		<interval-sec>0.3</interval-sec>
		<binding>
			<command>property-adjust</command>
			<property>instrumentation/airspeed-indicator/needle-value</property>
			<step>0.5</step>
			<min>0.0</min>
			<max>1.00</max>
		</binding>
	</action>
	<action>
		<button>1</button>
		<repeatable>true</repeatable>
		<interval-sec>0.3</interval-sec>
		<binding>
			<command>property-adjust</command>
			<property>instrumentation/airspeed-indicator/needle-value</property>
			<step>-0.5</step>
			<min>0.0</min>
			<max>1.00</max>
		</binding>
	</action>
</animation>  

</PropertyList>

